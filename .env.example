# Recommended: BYOK — OpenRouter (default). One key unlocks models you pick via MODELS=
OPENROUTER_API_KEY=

# Optional: PROVIDER=openrouter (default) | hetzner
# PROVIDER=openrouter

# Optional experimental BYOK — Hetzner Experiments Inference (not Cloud API tokens).
# Create token: https://experiments.hetzner.com → Apps → Inference → Create API Token
# Docs: https://experiments.hetzner.com/docs/inference
# Free while Hetzner marks the API experimental; no SLA. Never commit real keys.
# HETZNER_INFERENCE_API_KEY=
# PROVIDER=hetzner
# MODELS=Kimi-K2.7-Code,DeepSeek-V4-Flash-0731,GLM-5.2-NVFP4,Qwen/Qwen3.6-35B-A3B-FP8

# Direct lab keys are not used by suite runners (OpenRouter or Hetzner paths only)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# XAI_API_KEY=

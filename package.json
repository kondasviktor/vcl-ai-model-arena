{
  "name": "vcl-ai-model-arena",
  "version": "1.0.0",
  "private": true,
  "description": "VCL VibeBench — open AI model benchmark by Vibe Coder's Life",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "eval:fun": "node scripts/run-eval.js fun",
    "eval:dev": "node scripts/run-eval.js dev",
    "eval:score": "node scripts/run-eval.js score",
    "eval:all": "npm run eval:fun && npm run eval:dev",
    "eval:smoke": "node scripts/run-eval.js fun --smoke",
    "eval:score:smoke": "node scripts/run-eval.js score --smoke",
    "eval:hetzner:smoke": "PROVIDER=hetzner MODELS=Qwen/Qwen3.6-35B-A3B-FP8 node scripts/run-eval.js fun --smoke",
    "test:score:harness": "node scripts/test-score-harness.js",
    "view": "promptfoo view",
    "results:latest": "node scripts/build-latest-results.js",
    "hf:export": "node scripts/build-hf-dataset.js",
    "validate:models": "node scripts/validate-openrouter-ids.js"
  },
  "devDependencies": {
    "js-yaml": "5.5.0",
    "promptfoo": "0.125.1"
  },
  "overrides": {
    "basic-ftp": "^6.2.3",
    "@azure/msal-node": "^7.1.1"
  }
}
